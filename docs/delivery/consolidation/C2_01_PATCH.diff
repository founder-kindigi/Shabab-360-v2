+++ b/src/lib/security/unit-environment.test.ts
@@ -0,0 +1,44 @@
+import { execFileSync } from "node:child_process";
+import { describe, expect, it } from "vitest";
+
+// Child processes exercise initialization order; all hostile values are synthetic.
+const hostile = {
+  ...process.env, DATABASE_URL: "postgresql://synthetic:synthetic@forbidden.invalid/app",
+  DIRECT_URL: "postgresql://synthetic:synthetic@forbidden.invalid/direct",
+  NEXTAUTH_URL: "https://forbidden.invalid", NEXTAUTH_SECRET: "synthetic-hostile-secret",
+  PGHOST: "forbidden.invalid", PGPASSWORD: "synthetic", POSTGRES_URL: "synthetic",
+  PRISMA_ACCELERATE_URL: "synthetic", SMTP_HOST: "forbidden.invalid",
+  IMPORT_HMAC_SECRET: "synthetic-hostile-secret",
+};
+const assertions = `
+  assert.equal(process.env.DATABASE_URL, "file::memory:");
+  assert.equal(process.env.DIRECT_URL, "postgresql://test:test@127.0.0.1:1/shabab360_test");
+  assert.equal(process.env.NEXTAUTH_URL, "http://127.0.0.1:3000");
+  assert.equal(process.env.NEXTAUTH_SECRET, "vitest-test-secret-not-for-deployment");
+  for (const key of ["PGHOST", "PGPASSWORD", "POSTGRES_URL", "PRISMA_ACCELERATE_URL", "SMTP_HOST"])
+    assert.equal(process.env[key], undefined);
+  assert.equal(process.env.IMPORT_HMAC_SECRET, "vitest-import-secret-not-for-deployment");
+`;
+describe("ordinary test environment", () => {
+  it("overrides inherited connections during config load before test imports", () => {
+    const code = `import assert from "node:assert/strict";
+      const { loadConfigFromFile } = await import("vite");
+      await loadConfigFromFile({command:"serve",mode:"test"}, "vitest.config.ts");
+      ${assertions}
+      process.stdout.write("isolated");
+    `;
+    expect(execFileSync(process.execPath, ["--input-type=module", "-e", code],
+      { cwd: process.cwd(), env: hostile, encoding: "utf8", timeout: 20000 })).toBe("isolated");
+  });
+  it("reapplies isolation in setup before the real database module initializes", () => {
+    const code = `import assert from "node:assert/strict";
+      await import("./vitest.setup.ts");
+      ${assertions}
+      const { db } = await import("./src/lib/db.ts");
+      await db.$disconnect();
+      process.stdout.write("isolated");
+    `;
+    expect(execFileSync(process.execPath, ["--input-type=module", "-e", code],
+      { cwd: process.cwd(), env: hostile, encoding: "utf8", timeout: 20000 })).toBe("isolated");
+  });
+});
