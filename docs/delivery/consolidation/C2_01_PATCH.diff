--- /dev/null
+++ b/scripts/testing/unit-environment.mjs
@@ -0,0 +1,17 @@
+// Unit tests must never reuse developer/provider connection settings.
+export const UNIT_TEST_ENV = Object.freeze({
+  DATABASE_URL: "file::memory:",
+  DIRECT_URL: "postgresql://test:test@127.0.0.1:1/shabab360_test",
+  NEXTAUTH_URL: "http://127.0.0.1:3000",
+  NEXTAUTH_SECRET: "vitest-test-secret-not-for-deployment",
+  IMPORT_HMAC_SECRET: "vitest-import-secret-not-for-deployment",
+});
+
+export function isolateUnitEnvironment() {
+  for (const key of Object.keys(process.env)) {
+    if (/(?:DATABASE|DIRECT_URL|POSTGRES|^PG|^PRISMA_|^NEXTAUTH_|^AUTH_|^SMTP_|^RESEND_|^SENDGRID_|^IMPORT_HMAC_SECRET$)/i.test(key)) {
+      delete process.env[key];
+    }
+  }
+  Object.assign(process.env, UNIT_TEST_ENV);
+}
