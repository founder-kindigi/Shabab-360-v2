diff --git a/src/lib/audit-privacy.test.ts b/src/lib/audit-privacy.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/audit-privacy.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it, vi } from "vitest";
+vi.mock("@/lib/db", () => ({ db: {} }));
+import { createAuditLogData } from "./audit";
+
+describe("audit privacy correction", () => {
+  it("redacts nested names, credentials and free text in old and new values", () => {
+    const values = { applicantName: "Synthetic Person", invitationCode: "synthetic",
+      entries: [{ guardianName: "Synthetic Guardian", message: "private text", reason: "private text",
+        body: "private text", content: "private text", password: "synthetic", state: "active" }] };
+    const data = createAuditLogData({ action: "update", entityType: "record", oldValues: values, newValues: values });
+    const expected = { applicantName: "[REDACTED]", invitationCode: "[REDACTED]",
+      entries: [{ guardianName: "[REDACTED]", message: "[REDACTED]", reason: "[REDACTED]",
+        body: "[REDACTED]", content: "[REDACTED]", password: "[REDACTED]", state: "active" }] };
+    expect(JSON.parse(data.newValues!)).toEqual(expected);
+    expect(JSON.parse(data.oldValues!)).toEqual(expected);
+  });
+  it("preserves safe identifiers, counts, dates and bounded operational text", () => {
+    const data = createAuditLogData({ action: "update", entityType: "content", entityId: "record-1",
+      newValues: { contentBlockId: "block-1", messageId: "message-1", count: 2, state: "active",
+        at: new Date("2026-09-12T00:00:00Z"), summary: "x".repeat(600) } });
+    expect(data.entityId).toBe("record-1");
+    expect(JSON.parse(data.newValues!)).toEqual({ contentBlockId: "block-1", messageId: "message-1",
+      count: 2, state: "active", at: "2026-09-12T00:00:00.000Z", summary: "x".repeat(500) + "... [TRUNCATED]" });
+  });
+  it("bounds recursion even for a cyclic payload without exposing nested data", () => {
+    const value: Record<string, unknown> = {}; value.child = value;
+    const data = createAuditLogData({ action: "update", entityType: "record", newValues: value });
+    expect(data.newValues!.length).toBeLessThan(500);
+    expect(data.newValues).toContain("[TRUNCATED]");
+  });
+});
