diff --git a/src/lib/security/credential-responses.test.ts b/src/lib/security/credential-responses.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/security/credential-responses.test.ts
@@ -0,0 +1,80 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { NextRequest, NextResponse } from "next/server";
+const mocks = vi.hoisted(() => ({
+  role: vi.fn(), capability: vi.fn(), auth: vi.fn(), scope: vi.fn(), audit: vi.fn(), email: vi.fn(),
+  findUnique: vi.fn(), findFirst: vi.fn(), cities: vi.fn(), parks: vi.fn(), groups: vi.fn(),
+  transaction: vi.fn(),
+}));
+vi.mock("@/lib/auth/authorize", () => ({ requireRole: mocks.role, requireCapability: mocks.capability,
+  requireAuth: mocks.auth, requireResourceScope: mocks.scope }));
+vi.mock("@/lib/db", () => ({ db: { user: { findUnique: mocks.findUnique, findFirst: mocks.findFirst },
+  city: { findMany: mocks.cities }, park: { findMany: mocks.parks }, group: { findMany: mocks.groups },
+  $transaction: mocks.transaction } }));
+vi.mock("@/lib/audit", () => ({ logAudit: mocks.audit }));
+vi.mock("@/lib/email-service", () => ({ sendInviteEmail: mocks.email }));
+vi.mock("bcryptjs", () => ({ default: { hash: vi.fn().mockResolvedValue("synthetic-hash") } }));
+import { POST as invite } from "@/app/api/admin/invite/route";
+import { POST as guardian } from "@/app/api/admin/guardians/invite/route";
+import { POST as users } from "@/app/api/admin/import/users/route";
+import { POST as participants } from "@/app/api/admin/import/participants/route";
+
+function json(body: object) {
+  return new NextRequest("http://localhost/api/synthetic", { method: "POST",
+    headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+}
+function csv(text: string) {
+  const form = new FormData(); form.set("file", new File([text], "synthetic.csv", { type: "text/csv" }));
+  return new NextRequest("http://localhost/api/synthetic", { method: "POST", body: form });
+}
+const cases = [
+  { label: "staff invite", handler: invite, request: () => json({ name: "Synthetic Staff", email: "staff@example.test", role: "program_admin" }), status: 201 },
+  { label: "guardian invite", handler: guardian, request: () => json({ name: "Synthetic Guardian", phone: "00000", relationship: "Guardian" }), status: 201 },
+  { label: "user import", handler: users, request: () => csv("name,email,role\nSynthetic Staff,staff@example.test,program_admin"), status: 200 },
+  { label: "participant import", handler: participants, request: () => csv("name,email,group\nSynthetic Student,student@example.test,Synthetic Group"), status: 200 },
+];
+describe("credential response cache protection", () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+    mocks.role.mockResolvedValue(null); mocks.email.mockResolvedValue(undefined);
+    const actor = { user: { id: "admin-1", role: "super_admin" } };
+    mocks.capability.mockResolvedValue(actor); mocks.auth.mockResolvedValue(actor); mocks.scope.mockReturnValue(null);
+    mocks.findUnique.mockResolvedValue(null); mocks.findFirst.mockResolvedValue(null);
+    mocks.cities.mockResolvedValue([]); mocks.parks.mockResolvedValue([]);
+    mocks.groups.mockResolvedValue([{ id: "group-1", name: "Synthetic Group",
+      batch: { parkId: "park-1", park: { cityId: "city-1" } } }]);
+    mocks.transaction.mockImplementation(async callback => callback({
+      user: { create: vi.fn().mockResolvedValue({ id: "user-1", mustResetPwd: true }),
+        findUnique: vi.fn().mockImplementation(({ where }) => where.id ? { id: where.id, mustResetPwd: true } : null) },
+      staffMeta: { create: vi.fn().mockResolvedValue({ id: "staff-1" }) },
+      guardian: { create: vi.fn().mockResolvedValue({ id: "guardian-1" }) },
+      participant: { create: vi.fn().mockResolvedValue({ id: "participant-1" }) },
+    }));
+  });
+  it.each(cases)("$label preserves status/body and forbids credential caching", async ({handler,request,status}) => {
+    const response = await handler(request());
+    expect(response.status).toBe(status);
+    const body = await response.json();
+    const hasSecret = status === 201 ? typeof body.temporaryPassword === "string"
+      : body.success === 1 && body.generatedPasswords.length === 1 && typeof body.generatedPasswords[0].password === "string";
+    expect(hasSecret).toBe(true);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+    expect(response.headers.get("cache-control")).toContain("private");
+    expect(response.headers.get("pragma")).toBe("no-cache");
+    expect(response.headers.get("expires")).toBe("0");
+  });
+  it.each(cases)("$label preserves denial before persistence", async ({handler,request}) => {
+    mocks.role.mockResolvedValue(NextResponse.json({ error: "Forbidden" }, { status: 403 }));
+    const response = await handler(request());
+    expect(response.status).toBe(403); expect(mocks.transaction).not.toHaveBeenCalled();
+    expect(await response.json()).toEqual({ error: "Forbidden" });
+  });
+  it("keeps import failure rows free of credentials", async () => {
+    mocks.transaction.mockRejectedValue(new Error("synthetic database failure"));
+    const response = await users(cases[2].request());
+    const body = await response.json();
+    expect(response.status).toBe(200); expect(body.success).toBe(0);
+    expect(body.generatedPasswords).toEqual([]);
+    expect(body.errors).toEqual([{ row: 2, message: "Import processing failed" }]);
+    expect(response.headers.get("cache-control")).toContain("no-store");
+  });
+});
