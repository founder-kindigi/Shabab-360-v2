# Local secrets and Vercel project state must never enter deployment archives.
.env
.env.*
!.env.example
.vercel

# Dependencies and generated build/test output are recreated by Vercel.
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Local databases, worktrees, logs, and operator-only source artifacts.
.worktrees
*.db
*.db-journal
*.db-wal
*.log
docs/sheets
.audit-typecheck.exit
