generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== AUTH & USERS ==========

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  mustResetPwd Boolean  @default(true)
  tokenVersion Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffMeta              StaffMeta?
  guardian               Guardian?
  participant            Participant?
  auditLogs              AuditLog[]
  announcements          Announcement[]
  notifications          Notification[]
  capabilityOverrides    UserCapabilityOverride[]
  externalSupportCallers ExternalSupportCaller[]
  callingTemplateUses    CallingTemplateUse[]
  callInteractions       CallInteraction[]
  mashwaraMeetings       MashwaraMeeting[]
  mediaBriefsCreated     MediaBrief[]             @relation("MediaBriefCreator")

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  reason     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

// ========== ACCESS MANAGEMENT ==========

// Role-level exceptions extend or remove the version-controlled defaults in
// src/lib/auth/capabilities.ts. The application validates fixed role and
// capability values before writing either override table.
model RoleCapabilityOverride {
  id         String   @id @default(cuid())
  role       String
  capability String
  effect     String
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, capability])
  @@index([role])
  @@map("role_capability_overrides")
}

// A single record is retained per user/capability so a revoke can be audited
// without losing the original operational reason. Expired or inactive records
// do not affect effective access.
model UserCapabilityOverride {
  id         String    @id @default(cuid())
  userId     String
  capability String
  effect     String
  reason     String
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId, isActive, expiresAt])
  @@map("user_capability_overrides")
}

// ========== ORGANIZATIONAL HIERARCHY ==========

model City {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parks                 Park[]
  batches               Batch[]
  cityHeads             StaffMeta[]            @relation("CityHeadAssignment")
  collaborationTeams    CollaborationTeam[]
  contentPlans          ContentPlan[]
  admissionApplications AdmissionApplication[]
  events                Event[]
  callingCampaigns      CallingCampaign[]
  callingTemplates      CallingTemplate[]
  mashwaraMeetings      MashwaraMeeting[]
  mediaBriefs           MediaBrief[]

  @@map("cities")
}

model Park {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batches               Batch[]
  groups                Group[]
  contentPlans          ContentPlan[]
  parkStaff             StaffMeta[]            @relation("ParkStaffAssignment")
  admissionApplications AdmissionApplication[]

  @@map("parks")
}

model Batch {
  id        String    @id @default(cuid())
  name      String
  parkId    String
  cityId    String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  park         Park           @relation(fields: [parkId], references: [id], onDelete: Cascade)
  city         City?          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  groups       Group[]
  settings     BatchSettings?
  feeEvents    FeeEvent[]
  contentPlans ContentPlan[]

  @@index([cityId, isActive])
  @@map("batches")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  batchId   String
  parkId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  park             Park?             @relation(fields: [parkId], references: [id], onDelete: Cascade)
  participants     Participant[]
  murabbis         StaffMeta[]       @relation("MurabbiAssignment")
  attendanceEvents AttendanceEvent[]
  rosterSnapshots  AttendanceRosterSnapshot[]

  @@index([batchId, isActive])
  @@index([parkId, batchId, isActive])
  @@map("groups")
}

// ========== PEOPLE ==========

model StaffMeta {
  id              String   @id @default(cuid())
  userId          String   @unique
  role            String
  assignedCityId  String?
  assignedParkId  String?
  assignedGroupId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCity              City?                  @relation("CityHeadAssignment", fields: [assignedCityId], references: [id], onDelete: SetNull)
  assignedPark              Park?                  @relation("ParkStaffAssignment", fields: [assignedParkId], references: [id], onDelete: SetNull)
  assignedGroup             Group?                 @relation("MurabbiAssignment", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  teamMemberships           StaffTeamMembership[]
  assignedActivityPlans     ActivityPlanItem[]     @relation("ActivityAssignee")
  eventTeamMemberships      EventTeamMembership[]
  eventResponsibilities     EventResponsibility[]
  assignedEventPlannerItems EventPlannerItem[]     @relation("EventPlannerAssignee")
  callingAssignments        CallingAssignment[]
  mashwaraAttendees         MashwaraAttendee[]
  mashwaraDecisions         MashwaraDecision[]
  mashwaraActionItems       MashwaraActionItem[]
  mashwaraShares            MashwaraMeetingShare[] @relation("MashwaraShareRecipient")
  mashwaraGrants            MashwaraMeetingShare[] @relation("MashwaraShareGranter")
  mediaAssignments          MediaBrief[]           @relation("MediaAssignee")
  mediaApprovals            MediaBrief[]           @relation("MediaApprover")
  staffAttendanceRecords    StaffAttendanceRecord[]

  @@map("staff_meta")
}

// Collaboration teams are operational groups, never login roles or scope grants.
model CollaborationTeam {
  id          String   @id @default(cuid())
  cityId      String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city                     City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  memberships              StaffTeamMembership[]
  contentBlocks            ContentPlanBlock[]
  activityPlans            ActivityPlanItem[]
  mashwaraDecisionTargets  MashwaraDecision[]    @relation("MashwaraDecisionTargetTeam")
  mashwaraActionItemsTeams MashwaraActionItem[]  @relation("MashwaraActionItemTeam")
  mediaBriefs              MediaBrief[]

  @@unique([cityId, code])
  @@index([cityId, isActive])
  @@map("collaboration_teams")
}

// Keep team responsibility history without changing canonical role or hierarchy scope.
model StaffTeamMembership {
  id          String    @id @default(cuid())
  staffMetaId String
  teamId      String
  title       String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staffMeta StaffMeta         @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)
  team      CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([staffMetaId, teamId, startedAt])
  @@index([staffMetaId, isActive])
  @@index([teamId, isActive])
  @@map("staff_team_memberships")
}

// City templates and reviewed park overrides preserve their original source.
model ContentPlan {
  id             String   @id @default(cuid())
  cityId         String
  batchId        String?
  parkId         String?
  basePlanId     String?
  name           String
  kind           String   @default("template")
  status         String   @default("draft")
  sourceWorkbook String?
  sourceSheet    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city      City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batch     Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  park      Park?                @relation(fields: [parkId], references: [id], onDelete: SetNull)
  basePlan  ContentPlan?         @relation("ContentPlanOverrides", fields: [basePlanId], references: [id], onDelete: SetNull)
  overrides ContentPlan[]        @relation("ContentPlanOverrides")
  sessions  ContentPlanSession[]

  @@index([cityId, status])
  @@index([batchId])
  @@index([parkId])
  @@index([basePlanId])
  @@map("content_plans")
}

model ContentPlanSession {
  id          String   @id @default(cuid())
  planId      String
  weekLabel   String?
  dayLabel    String?
  sessionDate DateTime
  focusArea   String?
  sourceRow   Int?
  isOffDay    Boolean  @default(false)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan   ContentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  blocks ContentPlanBlock[]

  @@unique([planId, sessionDate])
  @@index([sessionDate, status])
  @@map("content_plan_sessions")
}

model ContentPlanBlock {
  id        String   @id @default(cuid())
  sessionId String
  teamId    String
  category  String
  title     String?
  content   String
  sortOrder Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session     ContentPlanSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team        CollaborationTeam     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  resources   ContentPlanResource[]
  activities  ActivityPlanItem[]
  mediaBriefs MediaBrief[]

  @@unique([sessionId, category, sortOrder])
  @@index([teamId, status])
  @@map("content_plan_blocks")
}

model ContentPlanResource {
  id        String   @id @default(cuid())
  blockId   String
  label     String
  url       String
  kind      String   @default("external_link")
  createdAt DateTime @default(now())

  block ContentPlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("content_plan_resources")
}

// Team activity planning is separate from attendance and does not grant scope.
model ActivityPlanItem {
  id                  String    @id @default(cuid())
  teamId              String
  contentBlockId      String?
  assignedStaffMetaId String?
  title               String
  description         String?
  status              String    @default("planned")
  scheduledFor        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  team          CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contentBlock  ContentPlanBlock? @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  assignedStaff StaffMeta?        @relation("ActivityAssignee", fields: [assignedStaffMetaId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([assignedStaffMetaId, status])
  @@map("activity_plan_items")
}

// Student Extended Profile — supplementary biographical, developmental, and
// wellbeing data beyond the canonical Participant record. Created on demand.
// Never duplicates Participant, Guardian, Group, Batch, Park, or City fields.
model StudentExtendedProfile {
  id                        String   @id @default(cuid())
  participantId             String   @unique
  // Education tab
  school                    String?
  college                   String?
  educationSystem           String?
  previousResults           String?
  awardsAchievements        String?
  averageGrade              String?
  favouriteSubjects         String?
  // Family & Background tab
  fatherName                String?
  fatherOccupation          String?
  siblings                  String?
  financialStatus           String?
  nativeArea                String?
  ethnicity                 String?
  modeOfTransport           String?
  // Interests & Skills tab
  subjectsOfInterest        String?
  extraCurricular           String?
  hobbies                   String?
  sports                    String?
  learningStyle             String?
  curiosity                 String?
  specialTalent             String?
  currentSkills             String?
  skillsWantToLearn         String?
  // Goals & Development tab
  generalGoals              String?
  vision                    String?
  mission                   String?
  deenBackground            String?
  careerAspirations         String?
  academicInterests         String?
  collegePlans              String?
  futureCareerGoals         String?
  strengths                 String?
  weaknesses                String?
  goodHabits                String?
  badHabits                 String?
  // Support & Wellbeing tab
  disability                String?
  specialNeed               String?
  moralCharacter            String?
  namaz                     String?
  // Personality & Skills tab
  leadershipSkills          String?
  personalityResponsibility String?
  communicationSkills       String?
  teamworkSkills            String?
  problemSolvingSkills      String?
  creativity                String?
  criticalThinking          String?
  adaptability              String?
  initiative                String?
  selfMotivation            String?
  integrity                 String?
  empathy                   String?
  reading                   String?
  learningInterest          String?
  // Metadata
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("student_extended_profiles")
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  phone     String
  cnic      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  children GuardianChild[]

  @@map("guardians")
}

model GuardianChild {
  id            String   @id @default(cuid())
  guardianId    String
  participantId String
  relation      String?
  createdAt     DateTime @default(now())

  guardian    Guardian    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([guardianId, participantId])
  @@map("guardian_children")
}

model Participant {
  id            String    @id @default(cuid())
  userId        String?   @unique
  name          String
  phone         String?
  dateOfBirth   DateTime?
  age           Int?
  gradeClass    String?
  gender        String?
  address       String?
  groupId       String?
  state         String    @default("active")
  joinedAt      DateTime  @default(now())
  dropoutAt     DateTime?
  dropoutReason String?
  dropoutSource String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  group             Group?                     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  guardianLinks     GuardianChild[]
  attendanceRecords AttendanceRecord[]
  payments          Payment[]
  convertedFromApp  AdmissionApplication?      @relation("ConvertedFrom")
  extendedProfile   StudentExtendedProfile?
  rosterSnapshots   AttendanceRosterSnapshot[]
  eventRegistrations EventRegistration[]

  @@index([groupId, state])
  @@map("participants")
}

// ========== ATTENDANCE ==========

model BatchSettings {
  id                      String   @id @default(cuid())
  batchId                 String   @unique
  warningAbsents          Int      @default(3)
  dropoutAbsents          Int      @default(6)
  automaticDropoutEnabled Boolean  @default(false)
  dropoutConsecutiveWeeks Int      @default(3)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  batch       Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  offWeekdays BatchOffWeekday[]
  offDates    BatchOffDate[]

  @@map("batch_settings")
}

model BatchOffWeekday {
  id              String        @id @default(cuid())
  batchSettingsId String
  weekday         Int
  createdAt       DateTime      @default(now())

  batchSettings BatchSettings @relation(fields: [batchSettingsId], references: [id], onDelete: Cascade)

  @@unique([batchSettingsId, weekday])
  @@map("batch_off_weekdays")
}

model BatchOffDate {
  id              String        @id @default(cuid())
  batchSettingsId String
  offDate         DateTime
  reason          String?
  createdAt       DateTime      @default(now())

  batchSettings BatchSettings @relation(fields: [batchSettingsId], references: [id], onDelete: Cascade)

  @@unique([batchSettingsId, offDate])
  @@index([batchSettingsId, offDate])
  @@map("batch_off_dates")
}

model AttendanceEvent {
  id        String    @id @default(cuid())
  groupId   String
  title     String
  eventDate DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group           Group                      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  records         AttendanceRecord[]
  staffRecords    StaffAttendanceRecord[]
  rosterSnapshots AttendanceRosterSnapshot[]

  @@index([groupId, eventDate])
  @@index([eventDate])
  @@map("attendance_events")
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  eventId       String
  participantId String
  status        String
  markedBy      String?
  markedAt      DateTime @default(now())
  editReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  eventRegistration EventRegistration?

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@map("attendance_records")
}

model StaffAttendanceRecord {
  id         String   @id @default(cuid())
  eventId    String
  staffId    String
  status     String
  markedBy   String?
  markedAt   DateTime @default(now())
  editReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff StaffMeta       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([eventId, staffId])
  @@index([eventId])
  @@index([staffId])
  @@map("staff_attendance_records")
}

model AttendanceRosterSnapshot {
  id            String   @id @default(cuid())
  eventId       String
  participantId String
  groupId       String?
  snapshotState String   @default("active")
  createdAt     DateTime @default(now())

  event       AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@map("attendance_roster_snapshots")
}

// ========== FEES ==========

model FeeEvent {
  id             String    @id @default(cuid())
  batchId        String
  title          String
  feeType        String
  amount         Float
  dueDate        DateTime?
  discountAmount Float     @default(0)
  waiverReason   String?
  waivedBy       String?
  waivedAt       DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch    Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([batchId, isActive, createdAt])
  @@index([isActive, createdAt])
  @@map("fee_events")
}

model Payment {
  id            String   @id @default(cuid())
  feeEventId    String
  participantId String
  amount        Float
  method        String
  receiptNo     String?  @unique
  recordedBy    String?
  notes         String?
  isPartial     Boolean  @default(false)
  waivedAmount  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feeEvent    FeeEvent    @relation(fields: [feeEventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([feeEventId, participantId])
  @@map("payments")
}

model ReceiptSequence {
  id        String   @id @default(cuid())
  prefix    String
  year      Int
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
  @@map("receipt_sequences")
}

// ========== ADMISSIONS ==========

model AdmissionApplication {
  id                     String    @id @default(cuid())
  trackingCode           String    @unique
  applicantName          String
  applicantDOB           DateTime?
  gender                 String?
  guardianName           String
  guardianPhone          String
  guardianRelation       String?
  cityId                 String?
  preferredParkId        String?
  status                 String    @default("submitted")
  notes                  String?
  emergencyContact       String?
  emergencyPhone         String?
  previousEducation      String?
  reference              String?
  convertedParticipantId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  city                 City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  preferredPark        Park?                @relation(fields: [preferredParkId], references: [id], onDelete: SetNull)
  interviews           AdmissionInterview[]
  convertedParticipant Participant?         @relation("ConvertedFrom", fields: [convertedParticipantId], references: [id])
  callingAssignments   CallingAssignment[]

  @@map("admission_applications")
}

model AdmissionInterview {
  id            String    @id @default(cuid())
  applicationId String
  scheduledDate DateTime?
  scheduledTime String?
  status        String    @default("scheduled")
  score1        Int?
  score2        Int?
  score3        Int?
  totalScore    Int?
  notes         String?
  conductedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("admission_interviews")
}

// ========== ANNOUNCEMENTS ==========

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  priority    String    @default("normal")
  targetRoles String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@map("announcements")
}

// ========== NOTIFICATIONS ==========

model Notification {
  id             String    @id @default(cuid())
  type           String    @default("in_app") // "email" | "in_app" | "push"
  channel        String // "password_reset" | "invite" | "fee_reminder" | "absence_alert" | "admission_status"
  recipientId    String?
  recipientEmail String?
  subject        String
  body           String
  data           String? // JSON metadata
  status         String    @default("pending") // "pending" | "sent" | "failed"
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  user User? @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([status])
  @@map("notifications")
}

// ========== REPORT PRESETS ==========

model ReportPreset {
  id         String   @id @default(cuid())
  userId     String
  name       String
  reportType String
  filters    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("report_presets")
}

// ========== PROGRAMME EVENTS ==========

model Event {
  id              String    @id @default(cuid())
  cityId          String
  title           String
  description     String?
  eventType       String
  status          String    @default("planned")
  venue           String?
  venueNotes      String?
  startDate       DateTime
  endDate         DateTime?
  capacity        Int?
  cost            Decimal?  @default(0)
  requiresConsent Boolean   @default(false)
  requiresMedical Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  city             City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  teams            TemporaryEventTeam[]
  responsibilities EventResponsibility[]
  plannerItems     EventPlannerItem[]
  registrations    EventRegistration[]

  @@index([cityId, status])
  @@index([cityId, startDate])
  @@index([status, startDate])
  @@map("events")
}

// Event registration is separate from regular attendance. A completed check-in
// may link to exactly one existing group attendance record, never create a duplicate.
model EventRegistration {
  id                 String   @id @default(cuid())
  eventId            String
  participantId      String
  status             String   @default("registered")
  consentStatus      String   @default("not_required")
  feeStatus          String   @default("not_required")
  attendanceRecordId String?  @unique
  registeredAt       DateTime @default(now())
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant      Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@unique([eventId, participantId])
  @@index([eventId, status])
  @@index([participantId, status])
  @@map("event_registrations")
}

model TemporaryEventTeam {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberships  EventTeamMembership[]
  plannerItems EventPlannerItem[]

  @@unique([eventId, title])
  @@index([eventId, isActive])
  @@map("temporary_event_teams")
}

model EventTeamMembership {
  id            String    @id @default(cuid())
  teamId        String
  staffMetaId   String
  title         String?
  assignedAt    DateTime  @default(now())
  assignedUntil DateTime?
  revokedAt     DateTime?
  revokedReason String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team      TemporaryEventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta          @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)

  @@unique([teamId, staffMetaId])
  @@index([staffMetaId, isActive])
  @@index([teamId, isActive])
  @@map("event_team_memberships")
}

model EventResponsibility {
  id                    String    @id @default(cuid())
  eventId               String?
  mashwaraId            String?
  mashwaraOccurrenceId  String?
  title                 String
  description           String?
  assignedToStaffMetaId String
  assignedBy            String
  cityId                String
  startDate             DateTime
  endDate               DateTime
  revokedAt             DateTime?
  revokedBy             String?
  revokedReason         String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event                 Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedToStaffMeta   StaffMeta              @relation(fields: [assignedToStaffMetaId], references: [id], onDelete: Cascade)
  callingPOCAssignments CallingPOCAssignment[]

  @@index([assignedToStaffMetaId, isActive])
  @@index([eventId, isActive])
  @@index([cityId, isActive])
  @@index([endDate, isActive])
  @@map("event_responsibilities")
}

model EventPlannerItem {
  id                    String    @id @default(cuid())
  eventId               String
  title                 String
  description           String?
  assignedToStaffMetaId String?
  teamId                String?
  dueDate               DateTime?
  priority              String    @default("medium")
  status                String    @default("pending")
  completedAt           DateTime?
  completionNote        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedStaffMeta StaffMeta?          @relation("EventPlannerAssignee", fields: [assignedToStaffMetaId], references: [id], onDelete: SetNull)
  team              TemporaryEventTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([assignedToStaffMetaId, status])
  @@index([teamId, status])
  @@index([dueDate, status])
  @@map("event_planner_items")
}

// ========== CALLING MODULE ADDITIVE MODELS ==========

model CallingCampaign {
  id          String   @id @default(cuid())
  cityId      String
  name        String
  description String?
  status      String   @default("draft")
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city            City                    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pocAssignments  CallingPOCAssignment[]
  assignments     CallingAssignment[]
  templates       CallingTemplate[]
  externalCallers ExternalSupportCaller[]

  @@unique([cityId, name])
  @@index([cityId, status])
  @@map("calling_campaigns")
}

model CallingPOCAssignment {
  id                    String   @id @default(cuid())
  campaignId            String
  eventResponsibilityId String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign            CallingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventResponsibility EventResponsibility @relation(fields: [eventResponsibilityId], references: [id], onDelete: Cascade)

  @@unique([campaignId, eventResponsibilityId])
  @@map("calling_poc_assignments")
}

model ExternalSupportCaller {
  id         String    @id @default(cuid())
  userId     String
  campaignId String
  isActive   Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    CallingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments CallingAssignment[]

  @@index([userId, isActive])
  @@index([campaignId, isActive])
  @@map("external_support_callers")
}

model CallingTemplate {
  id         String   @id @default(cuid())
  cityId     String
  campaignId String?
  title      String
  body       String
  status     String   @default("draft")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  city     City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  campaign CallingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uses     CallingTemplateUse[]

  @@unique([cityId, title, version])
  @@map("calling_templates")
}

model CallingTemplateUse {
  id              String   @id @default(cuid())
  templateId      String
  templateVersion Int
  callerUserId    String
  assignmentId    String
  variablesUsed   String
  valuesHmac      String
  usedAt          DateTime @default(now())

  template   CallingTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  caller     User              @relation(fields: [callerUserId], references: [id], onDelete: Restrict)
  assignment CallingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([callerUserId])
  @@map("calling_template_uses")
}

model CallingAssignment {
  id                String    @id @default(cuid())
  campaignId        String
  applicationId     String
  callerStaffMetaId String?
  callerExternalId  String?
  status            String    @default("pending")
  isActive          Boolean   @default(true)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign       CallingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application    AdmissionApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  staffCaller    StaffMeta?             @relation(fields: [callerStaffMetaId], references: [id], onDelete: SetNull)
  externalCaller ExternalSupportCaller? @relation(fields: [callerExternalId], references: [id], onDelete: SetNull)
  interactions   CallInteraction[]
  templateUses   CallingTemplateUse[]

  @@index([callerStaffMetaId, isActive])
  @@index([callerExternalId, isActive])
  @@map("calling_assignments")
}

model CallInteraction {
  id           String    @id @default(cuid())
  assignmentId String
  callerUserId String
  outcome      String
  notes        String?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())

  assignment CallingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  caller     User              @relation(fields: [callerUserId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@map("call_interactions")
}

// ========== MASHWARA (Weekly Meetings) ==========

model MashwaraMeeting {
  id             String   @id @default(cuid())
  cityId         String
  title          String
  scheduledAt    DateTime
  location       String?
  status         String   @default("scheduled")
  minutesSummary String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city      City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  attendees   MashwaraAttendee[]
  decisions   MashwaraDecision[]
  actionItems MashwaraActionItem[]
  shares      MashwaraMeetingShare[]

  @@index([cityId, status])
  @@index([scheduledAt])
  @@map("mashwara_meetings")
}

model MashwaraAttendee {
  id               String    @id @default(cuid())
  meetingId        String
  staffMetaId      String
  attendanceStatus String    @default("present")
  notes            String?
  checkedInAt      DateTime?

  meeting   MashwaraMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta       @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)

  @@unique([meetingId, staffMetaId])
  @@index([meetingId])
  @@index([staffMetaId])
  @@map("mashwara_attendees")
}

model MashwaraDecision {
  id           String   @id @default(cuid())
  meetingId    String
  decision     String
  category     String?
  targetTeamId String?
  assignedToId String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  meeting    MashwaraMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  targetTeam CollaborationTeam? @relation("MashwaraDecisionTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)
  assignedTo StaffMeta?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
  @@map("mashwara_decisions")
}

model MashwaraActionItem {
  id           String    @id @default(cuid())
  meetingId    String
  description  String
  teamId       String
  assignedToId String
  dueDate      DateTime?
  status       String    @default("open")
  createdAt    DateTime  @default(now())

  meeting    MashwaraMeeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  team       CollaborationTeam @relation("MashwaraActionItemTeam", fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo StaffMeta         @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@index([assignedToId, status])
  @@map("mashwara_action_items")
}

model MashwaraMeetingShare {
  id          String    @id @default(cuid())
  meetingId   String
  staffMetaId String
  grantedById String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  isRevoked   Boolean   @default(false)

  meeting   MashwaraMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta       @relation("MashwaraShareRecipient", fields: [staffMetaId], references: [id], onDelete: Cascade)
  grantedBy StaffMeta       @relation("MashwaraShareGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([meetingId, staffMetaId])
  @@index([meetingId, staffMetaId, isRevoked])
  @@index([staffMetaId])
  @@map("mashwara_meeting_shares")
}

// ========== MEDIA OPERATIONS ==========

model MediaBrief {
  id                    String    @id @default(cuid())
  cityId                String
  teamId                String
  title                 String
  description           String?
  mediaType             String    @default("graphic")
  format                String?
  status                String    @default("draft")
  priority              String    @default("medium")
  dueAt                 DateTime?
  contentBlockId        String?
  approvalState         String?
  approvedByStaffMetaId String?
  approvedAt            DateTime?
  rejectionReason       String?
  cancellationReason    String?
  assetMetadata         String?
  assignedToStaffMetaId String?
  version               Int       @default(1)
  isActive              Boolean   @default(true)
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  city            City              @relation(fields: [cityId], references: [id], onDelete: Restrict)
  team            CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  contentBlock    ContentPlanBlock? @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  assignedToStaff StaffMeta?        @relation("MediaAssignee", fields: [assignedToStaffMetaId], references: [id], onDelete: SetNull)
  approvedByStaff StaffMeta?        @relation("MediaApprover", fields: [approvedByStaffMetaId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("MediaBriefCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teamId, status])
  @@index([teamId, assignedToStaffMetaId, status])
  @@index([cityId, status])
  @@index([mediaType, status])
  @@index([priority, status])
  @@map("media_briefs")
}
