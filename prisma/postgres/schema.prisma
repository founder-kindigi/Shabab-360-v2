// Staged PostgreSQL target schema. Keep the active SQLite schema in
// prisma/schema.prisma until the approved staging cutover.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantState {
  active
  inactive
  on_leave
  warning
  dropout
  graduated
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum PaymentMethod {
  cash
  bank
  online
  other
  bank_transfer
  easypaisa
  jazzcash
}

enum NotificationType {
  email
  in_app
  push
}

enum NotificationChannel {
  password_reset
  password_changed
  invite
  fee_reminder
  absence_alert
  admission_status
}

enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  mustResetPwd Boolean  @default(true)
  tokenVersion Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffMeta           StaffMeta?
  guardian            Guardian?
  participant         Participant?
  auditLogs           AuditLog[]
  announcements       Announcement[]
  notifications       Notification[]
  capabilityOverrides UserCapabilityOverride[]
  externalSupportCallers ExternalSupportCaller[]
  callingTemplateUses    CallingTemplateUse[]
  callInteractions       CallInteraction[]
  mashwaraMeetings       MashwaraMeeting[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  reason     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

// ========== ACCESS MANAGEMENT ==========

// Role-level exceptions extend or remove the version-controlled defaults in
// src/lib/auth/capabilities.ts. The application validates fixed role and
// capability values before writing either override table.
model RoleCapabilityOverride {
  id         String   @id @default(cuid())
  role       String
  capability String
  effect     String
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, capability])
  @@index([role])
  @@map("role_capability_overrides")
}

// A single record is retained per user/capability so a revoke can be audited
// without losing the original operational reason. Expired or inactive records
// do not affect effective access.
model UserCapabilityOverride {
  id         String   @id @default(cuid())
  userId     String
  capability String
  effect     String
  reason     String
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId, isActive, expiresAt])
  @@map("user_capability_overrides")
}

model City {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parks                 Park[]
  batches               Batch[]
  cityHeads             StaffMeta[]            @relation("CityHeadAssignment")
  collaborationTeams    CollaborationTeam[]
  contentPlans          ContentPlan[]
  admissionApplications AdmissionApplication[]
  events                Event[]
  callingCampaigns      CallingCampaign[]
  callingTemplates      CallingTemplate[]
  mashwaraMeetings      MashwaraMeeting[]
  feeDonations          FeeDonation[]
  financialAdjustments  FinancialAdjustment[]
  purchaseOrders        PurchaseOrder[]
  digitalResources      DigitalResource[]

  @@map("cities")
}

model Park {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batches               Batch[]
  groups                Group[]
  contentPlans          ContentPlan[]
  parkStaff             StaffMeta[]            @relation("ParkStaffAssignment")
  admissionApplications AdmissionApplication[]
  feeDonations          FeeDonation[]
  financialAdjustments  FinancialAdjustment[]
  parkStocks            ParkStock[]
  stockRequests         StockRequest[]
  purchaseOrders        PurchaseOrder[]
  transfersFrom         StockTransfer[]        @relation("StockTransferFrom")
  transfersTo           StockTransfer[]        @relation("StockTransferTo")
  stockAuditLogs        StockAuditLog[]
  staffAttendanceEvents StaffAttendanceEvent[]

  @@map("parks")
}

model Batch {
  id        String    @id @default(cuid())
  name      String
  parkId    String
  cityId    String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  park      Park           @relation(fields: [parkId], references: [id], onDelete: Cascade)
  city      City?          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  groups    Group[]
  settings  BatchSettings?
  feeEvents FeeEvent[]
  contentPlans ContentPlan[]

  @@index([cityId, isActive])
  @@map("batches")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  batchId   String
  parkId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  park             Park?             @relation(fields: [parkId], references: [id], onDelete: Cascade)
  participants     Participant[]
  murabbis         StaffMeta[]       @relation("MurabbiAssignment")
  attendanceEvents AttendanceEvent[]

  @@index([batchId, isActive])
  @@index([parkId, batchId, isActive])
  @@map("groups")
}

model StaffMeta {
  id              String   @id @default(cuid())
  userId          String   @unique
  role            String
  assignedCityId  String?
  assignedParkId  String?
  assignedGroupId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCity              City?                 @relation("CityHeadAssignment", fields: [assignedCityId], references: [id], onDelete: SetNull)
  assignedPark              Park?                 @relation("ParkStaffAssignment", fields: [assignedParkId], references: [id], onDelete: SetNull)
  assignedGroup             Group?                @relation("MurabbiAssignment", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  teamMemberships           StaffTeamMembership[]
  assignedActivityPlans     ActivityPlanItem[]    @relation("ActivityAssignee")
  eventTeamMemberships      EventTeamMembership[]
  eventResponsibilities     EventResponsibility[]
  assignedEventPlannerItems EventPlannerItem[]    @relation("EventPlannerAssignee")
  callingAssignments        CallingAssignment[]
  mashwaraAttendees         MashwaraAttendee[]
  mashwaraDecisions         MashwaraDecision[]
  mashwaraActionItems       MashwaraActionItem[]
  mashwaraShares            MashwaraMeetingShare[] @relation("MashwaraShareRecipient")
  mashwaraGrants            MashwaraMeetingShare[] @relation("MashwaraShareGranter")
  chatMessages              TeamChatMessage[]
  staffAttendanceRecords    StaffAttendanceRecord[]

  @@map("staff_meta")
}

// Collaboration teams are operational groups, never login roles or scope grants.
model CollaborationTeam {
  id          String   @id @default(cuid())
  cityId      String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  memberships StaffTeamMembership[]
  contentBlocks ContentPlanBlock[]
  activityPlans ActivityPlanItem[]
  chatMessages  TeamChatMessage[]
  mashwaraDecisionTargets  MashwaraDecision[] @relation("MashwaraDecisionTargetTeam")
  mashwaraActionItemsTeams MashwaraActionItem[] @relation("MashwaraActionItemTeam")

  @@unique([cityId, code])
  @@index([cityId, isActive])
  @@map("collaboration_teams")
}

// Keep team responsibility history without changing canonical role or hierarchy scope.
model StaffTeamMembership {
  id          String   @id @default(cuid())
  staffMetaId String
  teamId      String
  title       String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffMeta StaffMeta         @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)
  team      CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([staffMetaId, teamId, startedAt])
  @@index([staffMetaId, isActive])
  @@index([teamId, isActive])
  @@map("staff_team_memberships")
}

// City templates and reviewed park overrides preserve their original source.
model ContentPlan {
  id             String   @id @default(cuid())
  cityId         String
  batchId        String?
  parkId         String?
  basePlanId     String?
  name           String
  kind           String   @default("template")
  status         String   @default("draft")
  sourceWorkbook String?
  sourceSheet    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city      City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batch     Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  park      Park?         @relation(fields: [parkId], references: [id], onDelete: SetNull)
  basePlan  ContentPlan?  @relation("ContentPlanOverrides", fields: [basePlanId], references: [id], onDelete: SetNull)
  overrides ContentPlan[] @relation("ContentPlanOverrides")
  sessions  ContentPlanSession[]

  @@index([cityId, status])
  @@index([batchId])
  @@index([parkId])
  @@index([basePlanId])
  @@map("content_plans")
}

model ContentPlanSession {
  id          String   @id @default(cuid())
  planId      String
  weekLabel   String?
  dayLabel    String?
  sessionDate DateTime
  focusArea   String?
  sourceRow   Int?
  isOffDay    Boolean  @default(false)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan   ContentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  blocks ContentPlanBlock[]

  @@unique([planId, sessionDate])
  @@index([sessionDate, status])
  @@map("content_plan_sessions")
}

model ContentPlanBlock {
  id        String   @id @default(cuid())
  sessionId String
  teamId    String
  category  String
  title     String?
  content   String
  sortOrder Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   ContentPlanSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team      CollaborationTeam    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  resources ContentPlanResource[]
  activities ActivityPlanItem[]

  @@unique([sessionId, category, sortOrder])
  @@index([teamId, status])
  @@map("content_plan_blocks")
}

model ContentPlanResource {
  id        String   @id @default(cuid())
  blockId   String
  label     String
  url       String
  kind      String   @default("external_link")
  createdAt DateTime @default(now())

  block ContentPlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("content_plan_resources")
}

// Team activity planning is separate from attendance and does not grant scope.
model ActivityPlanItem {
  id                  String   @id @default(cuid())
  teamId              String
  contentBlockId      String?
  assignedStaffMetaId String?
  title               String
  description         String?
  status              String   @default("planned")
  scheduledFor        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  team          CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contentBlock  ContentPlanBlock? @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  assignedStaff StaffMeta?        @relation("ActivityAssignee", fields: [assignedStaffMetaId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([assignedStaffMetaId, status])
  @@map("activity_plan_items")
}

// Student Extended Profile — supplementary biographical, developmental, and
// wellbeing data beyond the canonical Participant record. Created on demand.
// Never duplicates Participant, Guardian, Group, Batch, Park, or City fields.
model StudentExtendedProfile {
  id                    String   @id @default(cuid())
  participantId         String   @unique
  // Education tab
  school                String?
  college               String?
  educationSystem       String?
  previousResults       String?
  awardsAchievements    String?
  averageGrade          String?
  favouriteSubjects     String?
  // Family & Background tab
  fatherName            String?
  fatherOccupation      String?
  siblings              String?
  financialStatus       String?
  nativeArea            String?
  ethnicity             String?
  modeOfTransport       String?
  // Interests & Skills tab
  subjectsOfInterest    String?
  extraCurricular       String?
  hobbies               String?
  sports                String?
  learningStyle         String?
  curiosity             String?
  specialTalent         String?
  currentSkills         String?
  skillsWantToLearn     String?
  // Goals & Development tab
  generalGoals          String?
  vision                String?
  mission               String?
  deenBackground        String?
  careerAspirations     String?
  academicInterests     String?
  collegePlans          String?
  futureCareerGoals     String?
  strengths             String?
  weaknesses            String?
  goodHabits            String?
  badHabits             String?
  // Support & Wellbeing tab
  disability            String?
  specialNeed           String?
  moralCharacter        String?
  namaz                 String?
  // Personality & Skills tab
  leadershipSkills      String?
  personalityResponsibility String?
  communicationSkills   String?
  teamworkSkills        String?
  problemSolvingSkills  String?
  creativity            String?
  criticalThinking      String?
  adaptability          String?
  initiative            String?
  selfMotivation        String?
  integrity             String?
  empathy               String?
  reading               String?
  learningInterest      String?
  // Metadata
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("student_extended_profiles")
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  phone     String
  cnic      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  children GuardianChild[]

  @@index([phone])
  @@map("guardians")
}

model GuardianChild {
  id            String   @id @default(cuid())
  guardianId    String
  participantId String
  relation      String?
  createdAt     DateTime @default(now())

  guardian    Guardian    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([guardianId, participantId])
  @@map("guardian_children")
}

model Participant {
  id          String           @id @default(cuid())
  userId      String?          @unique
  name        String
  phone       String?
  dateOfBirth DateTime?
  age         Int?
  gradeClass  String?
  gender      String?
  address     String?
  groupId     String
  state       ParticipantState @default(active)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  group             Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guardianLinks     GuardianChild[]
  attendanceRecords AttendanceRecord[]
  payments          Payment[]
  convertedFromApp  AdmissionApplication? @relation("ConvertedFrom")
  extendedProfile   StudentExtendedProfile?
  eventRegistrations EventRegistration[]
  pointTransactions PointTransaction[]
  unlockedBadges    StudentBadge[]

  @@index([groupId, state])
  @@map("participants")
}

model BatchSettings {
  id             String   @id @default(cuid())
  batchId        String   @unique
  warningAbsents Int      @default(3)
  dropoutAbsents Int      @default(6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("batch_settings")
}

model AttendanceEvent {
  id        String    @id @default(cuid())
  groupId   String
  title     String
  eventDate DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@index([groupId, eventDate])
  @@index([eventDate])
  @@map("attendance_events")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  eventId       String
  participantId String
  status        AttendanceStatus
  markedBy      String?
  markedAt      DateTime         @default(now())
  editReason    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event       AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@index([markedAt])
  @@map("attendance_records")
}

// Separate staff/Murabbi attendance tracking, scoped to Park (not Group).
model StaffAttendanceEvent {
  id        String    @id @default(cuid())
  parkId    String
  title     String
  eventDate DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  park    Park                     @relation(fields: [parkId], references: [id], onDelete: Cascade)
  records StaffAttendanceRecord[]

  @@index([parkId, eventDate])
  @@index([eventDate])
  @@map("staff_attendance_events")
}

model StaffAttendanceRecord {
  id          String           @id @default(cuid())
  eventId     String
  staffMetaId String
  status      AttendanceStatus
  markedBy    String?
  markedAt    DateTime         @default(now())
  editReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event     StaffAttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta            @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)

  @@unique([eventId, staffMetaId])
  @@index([eventId])
  @@index([staffMetaId])
  @@index([markedAt])
  @@map("staff_attendance_records")
}

model FeeEvent {
  id             String    @id @default(cuid())
  batchId        String
  title          String
  feeType        String
  amount         Decimal   @db.Decimal(12, 2)
  dueDate        DateTime?
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  waiverReason   String?
  waivedBy       String?
  waivedAt       DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch    Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([batchId, isActive, createdAt])
  @@index([isActive, createdAt])
  @@map("fee_events")
}

model Payment {
  id            String        @id @default(cuid())
  feeEventId    String
  participantId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  receiptNo     String?       @unique
  recordedBy    String?
  notes         String?
  isPartial     Boolean       @default(false)
  waivedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  feeEvent    FeeEvent    @relation(fields: [feeEventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([feeEventId, participantId])
  @@map("payments")
}

model ReceiptSequence {
  id        String   @id @default(cuid())
  prefix    String
  year      Int
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
  @@map("receipt_sequences")
}

model FeeDonation {
  id            String   @id @default(cuid())
  cityId        String
  parkId        String?
  donorName     String
  donorPhone    String?
  amount        Decimal  @db.Decimal(12, 2)
  method        PaymentMethod
  receiptNo     String?  @unique
  purpose       String?
  recordedBy    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city City  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  park Park? @relation(fields: [parkId], references: [id], onDelete: SetNull)

  @@index([cityId, createdAt])
  @@index([parkId, createdAt])
  @@map("fee_donations")
}

model FinancialAdjustment {
  id            String   @id @default(cuid())
  cityId        String
  parkId        String?
  type          String   // "credit" | "debit"
  amount        Decimal  @db.Decimal(12, 2)
  category      String   // "waiver" | "write_off" | "grant" | "correction"
  reason        String
  approvedBy    String
  recordedBy    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city City  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  park Park? @relation(fields: [parkId], references: [id], onDelete: SetNull)

  @@index([cityId, createdAt])
  @@index([parkId, createdAt])
  @@map("financial_adjustments")
}

model ProcurementItem {
  id           String      @id @default(cuid())
  sku          String      @unique
  name         String
  category     String      // "sports_equipment" | "stationery" | "apparel" | "event_materials" | "general"
  unit         String      // "piece" | "box" | "set" | "pack"
  unitCost     Decimal     @default(0) @db.Decimal(12, 2)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  parkStocks     ParkStock[]
  stockRequests  StockRequest[]
  purchaseOrders PurchaseOrder[]
  stockTransfers StockTransfer[]
  stockAuditLogs StockAuditLog[]

  @@map("procurement_items")
}

model ParkStock {
  id           String          @id @default(cuid())
  parkId       String
  itemId       String
  quantity     Int             @default(0)
  minThreshold Int             @default(5)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  park         Park            @relation(fields: [parkId], references: [id], onDelete: Cascade)
  item         ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([parkId, itemId])
  @@index([parkId])
  @@index([itemId])
  @@map("park_stocks")
}

model StockRequest {
  id           String          @id @default(cuid())
  parkId       String
  itemId       String
  quantity     Int
  reason       String
  status       String          @default("pending") // "pending" | "approved" | "rejected" | "fulfilled"
  requestedBy  String
  reviewedBy   String?
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  park         Park            @relation(fields: [parkId], references: [id], onDelete: Cascade)
  item         ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([parkId, status])
  @@index([itemId])
  @@map("stock_requests")
}

model PurchaseOrder {
  id           String          @id @default(cuid())
  poNumber     String          @unique
  cityId       String
  parkId       String?
  itemId       String
  quantity     Int
  unitCost     Decimal         @db.Decimal(12, 2)
  totalCost    Decimal         @db.Decimal(12, 2)
  supplierName String
  status       String          @default("issued") // "issued" | "received" | "cancelled"
  issuedBy     String
  receivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  city         City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  park         Park?           @relation(fields: [parkId], references: [id], onDelete: SetNull)
  item         ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([cityId, createdAt])
  @@index([parkId, createdAt])
  @@map("purchase_orders")
}

model StockTransfer {
  id            String          @id @default(cuid())
  fromParkId    String
  toParkId      String
  itemId        String
  quantity      Int
  reason        String?
  transferredBy String
  createdAt     DateTime        @default(now())

  fromPark      Park            @relation("StockTransferFrom", fields: [fromParkId], references: [id], onDelete: Cascade)
  toPark        Park            @relation("StockTransferTo", fields: [toParkId], references: [id], onDelete: Cascade)
  item          ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([fromParkId, createdAt])
  @@index([toParkId, createdAt])
  @@map("stock_transfers")
}

model StockAuditLog {
  id          String          @id @default(cuid())
  parkId      String
  itemId      String
  systemCount Int
  actualCount Int
  discrepancy Int
  reason      String
  auditedBy   String
  createdAt   DateTime        @default(now())

  park        Park            @relation(fields: [parkId], references: [id], onDelete: Cascade)
  item        ProcurementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([parkId, createdAt])
  @@map("stock_audit_logs")
}

model AdmissionApplication {
  id                     String    @id @default(cuid())
  trackingCode           String    @unique
  applicantName          String
  applicantDOB           DateTime?
  gender                 String?
  guardianName           String
  guardianPhone          String
  guardianRelation       String?
  cityId                 String?
  preferredParkId        String?
  status                 String    @default("submitted")
  notes                  String?
  emergencyContact       String?   @db.VarChar(120)
  emergencyPhone         String?   @db.VarChar(30)
  previousEducation      String?   @db.VarChar(200)
  reference              String?   @db.VarChar(120)
  convertedParticipantId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  city                 City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  preferredPark        Park?                @relation(fields: [preferredParkId], references: [id], onDelete: SetNull)
  interviews           AdmissionInterview[]
  convertedParticipant Participant?         @relation("ConvertedFrom", fields: [convertedParticipantId], references: [id])
  callingAssignments   CallingAssignment[]

  @@map("admission_applications")
}

model AdmissionInterview {
  id            String    @id @default(cuid())
  applicationId String
  scheduledDate DateTime?
  scheduledTime String?
  status        String    @default("scheduled")
  score1        Int?
  score2        Int?
  score3        Int?
  totalScore    Int?
  notes         String?
  conductedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("admission_interviews")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  priority    String    @default("normal")
  targetRoles String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([expiresAt])
  @@map("announcements")
}

model Notification {
  id             String              @id @default(cuid())
  type           NotificationType    @default(in_app)
  channel        NotificationChannel
  recipientId    String?
  recipientEmail String?
  subject        String
  body           String
  data           String?
  status         NotificationStatus  @default(pending)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  user User? @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([status])
  @@map("notifications")
}

model ReportPreset {
  id         String   @id @default(cuid())
  userId     String
  name       String
  reportType String
  filters    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("report_presets")
}

// ========== PROGRAMME EVENTS ==========

model Event {
  id              String   @id @default(cuid())
  cityId          String
  title           String
  description     String?
  eventType       String
  status          String   @default("planned")
  venue           String?
  venueNotes      String?
  startDate       DateTime
  endDate         DateTime?
  capacity        Int?
  cost            Decimal? @default(0)
  requiresConsent Boolean  @default(false)
  requiresMedical Boolean  @default(false)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city             City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  teams            TemporaryEventTeam[]
  responsibilities EventResponsibility[]
  plannerItems     EventPlannerItem[]
  registrations    EventRegistration[]

  @@index([cityId, status])
  @@index([cityId, startDate])
  @@index([status, startDate])
  @@map("events")
}

model TemporaryEventTeam {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberships  EventTeamMembership[]
  plannerItems EventPlannerItem[]

  @@unique([eventId, title])
  @@index([eventId, isActive])
  @@map("temporary_event_teams")
}

model EventTeamMembership {
  id            String    @id @default(cuid())
  teamId        String
  staffMetaId   String
  title         String?
  assignedAt    DateTime  @default(now())
  assignedUntil DateTime?
  revokedAt     DateTime?
  revokedReason String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team      TemporaryEventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta          @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)

  @@unique([teamId, staffMetaId])
  @@index([staffMetaId, isActive])
  @@index([teamId, isActive])
  @@map("event_team_memberships")
}

model EventResponsibility {
  id                    String    @id @default(cuid())
  eventId               String?
  mashwaraId            String?
  mashwaraOccurrenceId String?
  title                 String
  description           String?
  assignedToStaffMetaId String
  assignedBy            String
  cityId                String
  startDate             DateTime
  endDate               DateTime
  revokedAt             DateTime?
  revokedBy             String?
  revokedReason         String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event               Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedToStaffMeta StaffMeta @relation(fields: [assignedToStaffMetaId], references: [id], onDelete: Cascade)
  callingPOCAssignments CallingPOCAssignment[]

  @@index([assignedToStaffMetaId, isActive])
  @@index([eventId, isActive])
  @@index([cityId, isActive])
  @@index([endDate, isActive])
  @@map("event_responsibilities")
}

model EventPlannerItem {
  id                    String    @id @default(cuid())
  eventId               String
  title                 String
  description           String?
  assignedToStaffMetaId String?
  teamId                String?
  dueDate               DateTime?
  priority              String    @default("medium")
  status                String    @default("pending")
  completedAt           DateTime?
  completionNote        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedStaffMeta StaffMeta?          @relation("EventPlannerAssignee", fields: [assignedToStaffMetaId], references: [id], onDelete: SetNull)
  team              TemporaryEventTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([assignedToStaffMetaId, status])
  @@index([teamId, status])
  @@index([dueDate, status])
  @@map("event_planner_items")
}

// ========== CALLING MODULE ADDITIVE MODELS ==========

model CallingCampaign {
  id          String   @id @default(cuid())
  cityId      String
  name        String
  description String?
  status      String   @default("draft")
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city            City                    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pocAssignments  CallingPOCAssignment[]
  assignments     CallingAssignment[]
  templates       CallingTemplate[]
  externalCallers ExternalSupportCaller[]

  @@unique([cityId, name])
  @@index([cityId, status])
  @@map("calling_campaigns")
}

model CallingPOCAssignment {
  id                    String   @id @default(cuid())
  campaignId            String
  eventResponsibilityId String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign            CallingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventResponsibility EventResponsibility @relation(fields: [eventResponsibilityId], references: [id], onDelete: Cascade)

  @@unique([campaignId, eventResponsibilityId])
  @@map("calling_poc_assignments")
}

model ExternalSupportCaller {
  id         String    @id @default(cuid())
  userId     String
  campaignId String
  isActive   Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    CallingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments CallingAssignment[]

  @@index([userId, isActive])
  @@index([campaignId, isActive])
  @@map("external_support_callers")
}

model CallingTemplate {
  id         String   @id @default(cuid())
  cityId     String
  campaignId String?
  title      String
  body       String
  status     String   @default("draft")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  city     City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  campaign CallingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uses     CallingTemplateUse[]

  @@unique([cityId, title, version])
  @@map("calling_templates")
}

model CallingTemplateUse {
  id              String   @id @default(cuid())
  templateId      String
  templateVersion Int
  callerUserId    String
  assignmentId    String
  variablesUsed   String
  valuesHmac      String
  usedAt          DateTime @default(now())

  template   CallingTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  caller     User              @relation(fields: [callerUserId], references: [id], onDelete: Restrict)
  assignment CallingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([callerUserId])
  @@map("calling_template_uses")
}

model CallingAssignment {
  id                String    @id @default(cuid())
  campaignId        String
  applicationId     String
  callerStaffMetaId String?
  callerExternalId  String?
  status            String    @default("pending")
  isActive          Boolean   @default(true)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign       CallingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application    AdmissionApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  staffCaller    StaffMeta?             @relation(fields: [callerStaffMetaId], references: [id], onDelete: SetNull)
  externalCaller ExternalSupportCaller? @relation(fields: [callerExternalId], references: [id], onDelete: SetNull)
  interactions   CallInteraction[]
  templateUses   CallingTemplateUse[]

  @@index([callerStaffMetaId, isActive])
  @@index([callerExternalId, isActive])
  @@map("calling_assignments")
}

model CallInteraction {
  id           String    @id @default(cuid())
  assignmentId String
  callerUserId String
  outcome      String
  notes        String?
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())

  assignment CallingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  caller     User              @relation(fields: [callerUserId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@map("call_interactions")
}

// ========== MASHWARA (Weekly Meetings) ==========

enum MashwaraMeetingStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum MashwaraAttendanceStatus {
  present
  absent
  excused
}

enum MashwaraDecisionStatus {
  pending
  in_progress
  completed
}

enum MashwaraActionItemStatus {
  open
  in_progress
  completed
}

model MashwaraMeeting {
  id             String               @id @default(cuid())
  cityId         String
  title          String
  scheduledAt    DateTime
  location       String?
  status         MashwaraMeetingStatus @default(scheduled)
  minutesSummary String?
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  city      City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  attendees   MashwaraAttendee[]
  decisions   MashwaraDecision[]
  actionItems MashwaraActionItem[]
  shares      MashwaraMeetingShare[]

  @@index([cityId, status])
  @@index([scheduledAt])
  @@map("mashwara_meetings")
}

model MashwaraAttendee {
  id               String                 @id @default(cuid())
  meetingId        String
  staffMetaId      String
  attendanceStatus MashwaraAttendanceStatus @default(present)
  notes            String?
  checkedInAt      DateTime?

  meeting   MashwaraMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta       @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)

  @@unique([meetingId, staffMetaId])
  @@index([meetingId])
  @@index([staffMetaId])
  @@map("mashwara_attendees")
}

model MashwaraDecision {
  id           String                 @id @default(cuid())
  meetingId    String
  decision     String
  category     String?
  targetTeamId String?
  assignedToId String?
  status       MashwaraDecisionStatus @default(pending)
  createdAt    DateTime               @default(now())

  meeting    MashwaraMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  targetTeam CollaborationTeam? @relation("MashwaraDecisionTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)
  assignedTo StaffMeta?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
  @@map("mashwara_decisions")
}

model MashwaraActionItem {
  id           String                  @id @default(cuid())
  meetingId    String
  description  String
  teamId       String
  assignedToId String
  dueDate      DateTime?
  status       MashwaraActionItemStatus @default(open)
  createdAt    DateTime                @default(now())

  meeting    MashwaraMeeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  team       CollaborationTeam @relation("MashwaraActionItemTeam", fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo StaffMeta         @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@index([assignedToId, status])
  @@map("mashwara_action_items")
}

model MashwaraMeetingShare {
  id          String   @id @default(cuid())
  meetingId   String
  staffMetaId String
  grantedById String
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  isRevoked   Boolean  @default(false)

  meeting   MashwaraMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMeta StaffMeta       @relation("MashwaraShareRecipient", fields: [staffMetaId], references: [id], onDelete: Cascade)
  grantedBy StaffMeta       @relation("MashwaraShareGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([meetingId, staffMetaId])
  @@index([meetingId, staffMetaId, isRevoked])
  @@index([staffMetaId])
  @@map("mashwara_meeting_shares")
}

model TeamChatMessage {
  id         String   @id @default(cuid())
  teamId     String
  authorId   String
  message    String
  isFlagged  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team   CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author StaffMeta         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([authorId])
  @@map("team_chat_messages")
}

model EventRegistration {
  id            String   @id @default(cuid())
  eventId       String
  participantId String
  status        String   @default("registered")
  feeStatus     String   @default("unpaid")
  feeAmount     Decimal? @default(0)
  hasConsent    Boolean  @default(false)
  hasMedical    Boolean  @default(false)
  checkedInAt   DateTime?
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventId, participantId])
  @@index([eventId, status])
  @@index([participantId])
  @@map("event_registrations")
}

model PointTransaction {
  id          String      @id @default(cuid())
  studentId   String
  points      Int
  category    String      // "attendance" | "participation" | "quiz" | "conduct" | "manual_bonus"
  reason      String
  awardedBy   String
  createdAt   DateTime    @default(now())

  student     Participant @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([category])
  @@map("point_transactions")
}

model Badge {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  description    String
  iconUrl        String?
  category       String         // "attendance" | "achievement" | "leadership" | "special"
  requiredPoints Int            @default(0)
  createdAt      DateTime       @default(now())

  studentBadges  StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id          String      @id @default(cuid())
  studentId   String
  badgeId     String
  unlockedAt  DateTime    @default(now())

  student     Participant @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge       Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
  @@index([badgeId])
  @@map("student_badges")
}

model DigitalResource {
  id           String    @id @default(cuid())
  title        String
  description  String?
  fileUrl      String
  category     String    // "curriculum" | "activity_guide" | "policy" | "media"
  allowedRoles String    @default("all") // "all" or comma-separated roles e.g. "murabbi,park_lead"
  targetCityId String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  targetCity   City?     @relation(fields: [targetCityId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([targetCityId])
  @@map("digital_resources")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  category    String   // "best_practices" | "operational_guide" | "faq" | "training"
  tags        String?  // comma-separated tags e.g. "attendance,parents"
  isPublished Boolean  @default(true)
  viewCount   Int      @default(0)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublished])
  @@map("knowledge_articles")
}
