// Staged PostgreSQL target schema. Keep the active SQLite schema in
// prisma/schema.prisma until the approved staging cutover.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantState {
  active
  inactive
  on_leave
  warning
  dropout
  graduated
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum PaymentMethod {
  cash
  bank
  online
  other
  bank_transfer
  easypaisa
  jazzcash
}

enum NotificationType {
  email
  in_app
  push
}

enum NotificationChannel {
  password_reset
  password_changed
  invite
  fee_reminder
  absence_alert
  admission_status
}

enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  mustResetPwd Boolean  @default(true)
  tokenVersion Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffMeta     StaffMeta?
  guardian      Guardian?
  participant   Participant?
  auditLogs     AuditLog[]
  announcements Announcement[]
  notifications Notification[]
  capabilityOverrides UserCapabilityOverride[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  reason     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

// ========== ACCESS MANAGEMENT ==========

// Role-level exceptions extend or remove the version-controlled defaults in
// src/lib/auth/capabilities.ts. The application validates fixed role and
// capability values before writing either override table.
model RoleCapabilityOverride {
  id         String   @id @default(cuid())
  role       String
  capability String
  effect     String
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, capability])
  @@index([role])
  @@map("role_capability_overrides")
}

// A single record is retained per user/capability so a revoke can be audited
// without losing the original operational reason. Expired or inactive records
// do not affect effective access.
model UserCapabilityOverride {
  id         String   @id @default(cuid())
  userId     String
  capability String
  effect     String
  reason     String
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId, isActive, expiresAt])
  @@map("user_capability_overrides")
}

model City {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parks                 Park[]
  batches               Batch[]
  cityHeads             StaffMeta[]            @relation("CityHeadAssignment")
  collaborationTeams    CollaborationTeam[]
  contentPlans          ContentPlan[]
  admissionApplications AdmissionApplication[]

  @@map("cities")
}

model Park {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batches               Batch[]
  groups                Group[]
  contentPlans          ContentPlan[]
  parkStaff             StaffMeta[]            @relation("ParkStaffAssignment")
  admissionApplications AdmissionApplication[]

  @@map("parks")
}

model Batch {
  id        String    @id @default(cuid())
  name      String
  parkId    String
  cityId    String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  park      Park           @relation(fields: [parkId], references: [id], onDelete: Cascade)
  city      City?          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  groups    Group[]
  settings  BatchSettings?
  feeEvents FeeEvent[]
  contentPlans ContentPlan[]

  @@index([cityId, isActive])
  @@map("batches")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  batchId   String
  parkId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  park             Park?             @relation(fields: [parkId], references: [id], onDelete: Cascade)
  participants     Participant[]
  murabbis         StaffMeta[]       @relation("MurabbiAssignment")
  attendanceEvents AttendanceEvent[]

  @@index([batchId, isActive])
  @@index([parkId, batchId, isActive])
  @@map("groups")
}

model StaffMeta {
  id              String   @id @default(cuid())
  userId          String   @unique
  role            String
  assignedCityId  String?
  assignedParkId  String?
  assignedGroupId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCity  City?  @relation("CityHeadAssignment", fields: [assignedCityId], references: [id], onDelete: SetNull)
  assignedPark  Park?  @relation("ParkStaffAssignment", fields: [assignedParkId], references: [id], onDelete: SetNull)
  assignedGroup Group? @relation("MurabbiAssignment", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  teamMemberships StaffTeamMembership[]
  assignedActivityPlans ActivityPlanItem[] @relation("ActivityAssignee")

  @@map("staff_meta")
}

// Collaboration teams are operational groups, never login roles or scope grants.
model CollaborationTeam {
  id          String   @id @default(cuid())
  cityId      String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  memberships StaffTeamMembership[]
  contentBlocks ContentPlanBlock[]
  activityPlans ActivityPlanItem[]

  @@unique([cityId, code])
  @@index([cityId, isActive])
  @@map("collaboration_teams")
}

// Keep team responsibility history without changing canonical role or hierarchy scope.
model StaffTeamMembership {
  id          String   @id @default(cuid())
  staffMetaId String
  teamId      String
  title       String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffMeta StaffMeta         @relation(fields: [staffMetaId], references: [id], onDelete: Cascade)
  team      CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([staffMetaId, teamId, startedAt])
  @@index([staffMetaId, isActive])
  @@index([teamId, isActive])
  @@map("staff_team_memberships")
}

// City templates and reviewed park overrides preserve their original source.
model ContentPlan {
  id             String   @id @default(cuid())
  cityId         String
  batchId        String?
  parkId         String?
  basePlanId     String?
  name           String
  kind           String   @default("template")
  status         String   @default("draft")
  sourceWorkbook String?
  sourceSheet    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city      City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batch     Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  park      Park?         @relation(fields: [parkId], references: [id], onDelete: SetNull)
  basePlan  ContentPlan?  @relation("ContentPlanOverrides", fields: [basePlanId], references: [id], onDelete: SetNull)
  overrides ContentPlan[] @relation("ContentPlanOverrides")
  sessions  ContentPlanSession[]

  @@index([cityId, status])
  @@index([batchId])
  @@index([parkId])
  @@index([basePlanId])
  @@map("content_plans")
}

model ContentPlanSession {
  id          String   @id @default(cuid())
  planId      String
  weekLabel   String?
  dayLabel    String?
  sessionDate DateTime
  focusArea   String?
  sourceRow   Int?
  isOffDay    Boolean  @default(false)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan   ContentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  blocks ContentPlanBlock[]

  @@unique([planId, sessionDate])
  @@index([sessionDate, status])
  @@map("content_plan_sessions")
}

model ContentPlanBlock {
  id        String   @id @default(cuid())
  sessionId String
  teamId    String
  category  String
  title     String?
  content   String
  sortOrder Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   ContentPlanSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team      CollaborationTeam    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  resources ContentPlanResource[]
  activities ActivityPlanItem[]

  @@unique([sessionId, category, sortOrder])
  @@index([teamId, status])
  @@map("content_plan_blocks")
}

model ContentPlanResource {
  id        String   @id @default(cuid())
  blockId   String
  label     String
  url       String
  kind      String   @default("external_link")
  createdAt DateTime @default(now())

  block ContentPlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("content_plan_resources")
}

// Team activity planning is separate from attendance and does not grant scope.
model ActivityPlanItem {
  id                  String   @id @default(cuid())
  teamId              String
  contentBlockId      String?
  assignedStaffMetaId String?
  title               String
  description         String?
  status              String   @default("planned")
  scheduledFor        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  team          CollaborationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contentBlock  ContentPlanBlock? @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  assignedStaff StaffMeta?        @relation("ActivityAssignee", fields: [assignedStaffMetaId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([assignedStaffMetaId, status])
  @@map("activity_plan_items")
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  phone     String
  cnic      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  children GuardianChild[]

  @@index([phone])
  @@map("guardians")
}

model GuardianChild {
  id            String   @id @default(cuid())
  guardianId    String
  participantId String
  relation      String?
  createdAt     DateTime @default(now())

  guardian    Guardian    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([guardianId, participantId])
  @@map("guardian_children")
}

model Participant {
  id          String           @id @default(cuid())
  userId      String?          @unique
  name        String
  phone       String?
  dateOfBirth DateTime?
  age         Int?
  gradeClass  String?
  gender      String?
  address     String?
  groupId     String
  state       ParticipantState @default(active)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  group             Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guardianLinks     GuardianChild[]
  attendanceRecords AttendanceRecord[]
  payments          Payment[]
  convertedFromApp  AdmissionApplication? @relation("ConvertedFrom")

  @@index([groupId, state])
  @@map("participants")
}

model BatchSettings {
  id             String   @id @default(cuid())
  batchId        String   @unique
  warningAbsents Int      @default(3)
  dropoutAbsents Int      @default(6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("batch_settings")
}

model AttendanceEvent {
  id        String    @id @default(cuid())
  groupId   String
  title     String
  eventDate DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@index([groupId, eventDate])
  @@index([eventDate])
  @@map("attendance_events")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  eventId       String
  participantId String
  status        AttendanceStatus
  markedBy      String?
  markedAt      DateTime         @default(now())
  editReason    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event       AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([participantId])
  @@index([markedAt])
  @@map("attendance_records")
}

model FeeEvent {
  id             String    @id @default(cuid())
  batchId        String
  title          String
  feeType        String
  amount         Decimal   @db.Decimal(12, 2)
  dueDate        DateTime?
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  waiverReason   String?
  waivedBy       String?
  waivedAt       DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch    Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([batchId, isActive, createdAt])
  @@index([isActive, createdAt])
  @@map("fee_events")
}

model Payment {
  id            String        @id @default(cuid())
  feeEventId    String
  participantId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  receiptNo     String?       @unique
  recordedBy    String?
  notes         String?
  isPartial     Boolean       @default(false)
  waivedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  feeEvent    FeeEvent    @relation(fields: [feeEventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([feeEventId, participantId])
  @@map("payments")
}

model ReceiptSequence {
  id        String   @id @default(cuid())
  prefix    String
  year      Int
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
  @@map("receipt_sequences")
}

model AdmissionApplication {
  id                     String    @id @default(cuid())
  trackingCode           String    @unique
  applicantName          String
  applicantDOB           DateTime?
  gender                 String?
  guardianName           String
  guardianPhone          String
  guardianRelation       String?
  cityId                 String?
  preferredParkId        String?
  status                 String    @default("submitted")
  notes                  String?
  emergencyContact       String?   @db.VarChar(120)
  emergencyPhone         String?   @db.VarChar(30)
  previousEducation      String?   @db.VarChar(200)
  reference              String?   @db.VarChar(120)
  convertedParticipantId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  city                 City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  preferredPark        Park?                @relation(fields: [preferredParkId], references: [id], onDelete: SetNull)
  interviews           AdmissionInterview[]
  convertedParticipant Participant?         @relation("ConvertedFrom", fields: [convertedParticipantId], references: [id])

  @@map("admission_applications")
}

model AdmissionInterview {
  id            String    @id @default(cuid())
  applicationId String
  scheduledDate DateTime?
  scheduledTime String?
  status        String    @default("scheduled")
  score1        Int?
  score2        Int?
  score3        Int?
  totalScore    Int?
  notes         String?
  conductedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("admission_interviews")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  priority    String    @default("normal")
  targetRoles String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([expiresAt])
  @@map("announcements")
}

model Notification {
  id             String              @id @default(cuid())
  type           NotificationType    @default(in_app)
  channel        NotificationChannel
  recipientId    String?
  recipientEmail String?
  subject        String
  body           String
  data           String?
  status         NotificationStatus  @default(pending)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  user User? @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([status])
  @@map("notifications")
}

model ReportPreset {
  id         String   @id @default(cuid())
  userId     String
  name       String
  reportType String
  filters    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("report_presets")
}
