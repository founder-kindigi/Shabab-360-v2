# Copy to .env for local development. Never commit a populated .env file.
# SQLite (local dev):
DATABASE_URL="file:../db/custom.db"
# PostgreSQL (staging/production — uncomment and configure):
# DATABASE_URL="postgresql://user:password@host:5432/shabab360?pgbouncer=true"
# DIRECT_URL="postgresql://user:password@host:5432/shabab360"
NEXTAUTH_URL="http://localhost:3000"
# Generate a unique long random value for each environment.
# Minimum 20 characters, never use the default value.
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"
